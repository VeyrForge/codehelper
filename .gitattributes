# Default LF for all text — Linux packaging, bash -n, and cross-platform clones.
# Windows shell scripts keep CRLF. Binary patterns are explicit for safety.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

